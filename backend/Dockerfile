FROM python:3.12-slim

ARG DATABASE_URL
ARG API_HOST=0.0.0.0
ARG API_PORT=8000
ARG ENVIRONMENT=production
ARG DEBUG=false
ARG CORS_ORIGINS=https://nuraskin.cc
ARG META_PIXEL_ID
ARG META_ACCESS_TOKEN
ARG META_TEST_EVENT_CODE
ARG TIKTOK_PIXEL_ID
ARG TIKTOK_ACCESS_TOKEN
ARG GOOGLE_SHEETS_WEBHOOK_URL
ARG GOOGLE_SERVICE_ACCOUNT_JSON
ARG GOOGLE_SHEET_ID
ARG LOG_LEVEL=INFO
ARG SECRET_KEY

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATABASE_URL=$DATABASE_URL \
    API_HOST=$API_HOST \
    API_PORT=$API_PORT \
    ENVIRONMENT=$ENVIRONMENT \
    DEBUG=$DEBUG \
    CORS_ORIGINS=$CORS_ORIGINS \
    META_PIXEL_ID=$META_PIXEL_ID \
    META_ACCESS_TOKEN=$META_ACCESS_TOKEN \
    META_TEST_EVENT_CODE=$META_TEST_EVENT_CODE \
    TIKTOK_PIXEL_ID=$TIKTOK_PIXEL_ID \
    TIKTOK_ACCESS_TOKEN=$TIKTOK_ACCESS_TOKEN \
    GOOGLE_SHEETS_WEBHOOK_URL=$GOOGLE_SHEETS_WEBHOOK_URL \
    GOOGLE_SERVICE_ACCOUNT_JSON=$GOOGLE_SERVICE_ACCOUNT_JSON \
    GOOGLE_SHEET_ID=$GOOGLE_SHEET_ID \
    LOG_LEVEL=$LOG_LEVEL \
    SECRET_KEY=$SECRET_KEY

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN adduser --disabled-password --gecos "" appuser \
    && chown -R appuser /app
USER appuser

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${API_PORT:-8000} --workers 2"]
